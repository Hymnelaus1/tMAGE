# Kopyala: cp config/env.sh.example config/env.sh  ve değerleri doldur
export SYNOPSYS_HOME=/opt/synopsys/tools
export CC_HOME=$SYNOPSYS_HOME/customcompiler/X-2025.06-SP2
export HSPICE_HOME=$SYNOPSYS_HOME/hspice/X-2025.06-SP2/hspice
export FINESIM_HOME=$SYNOPSYS_HOME/finesim/X-2025.06-SP2
export ICV_HOME_DIR=$SYNOPSYS_HOME/icvalidator/X-2025.06-SP2
export STARRC_HOME=$SYNOPSYS_HOME/starrc/X-2025.06-SP2
export PATH=$CC_HOME/bin:$HSPICE_HOME/bin:$FINESIM_HOME/bin:$ICV_HOME_DIR/bin:$STARRC_HOME/bin:$PATH
export SNPSLMD_LICENSE_FILE=27200@<lisans-sunucusu-ip>
export SAED90_PDK=/opt/synopsys/edk/SAED90nm_PDK_10222017
